# Port for the API server in development (the Vite dev server proxies /api to it).
# In production (`npm start`) a single server listens on PORT (default 8787).
API_PORT=8787

# Passcode for the admin review dashboard at /admin.
# `npm run setup` generates a random one into .env for you.
ADMIN_PASSCODE=change-me

# Optional: enables the AI pipeline (Basic AI Draft, grounded extraction, AI label OCR).
# Without it Assay still works end to end, using an on-device extractive summarizer
# over PubChem + PubMed text and Tesseract OCR in the browser.
ANTHROPIC_API_KEY=

# The plan calls for "a small, low-cost AI model". Override if you want a different one.
AI_MODEL=claude-haiku-4-5

# Optional: NCBI API key raises PubMed E-utilities limits from 3 to 10 requests/second.
NCBI_API_KEY=
# NCBI asks tools to identify themselves with a contact email.
NCBI_EMAIL=

# Optional: USDA FoodData Central key (free at api.data.gov) for "found in N branded foods" counts.
# Without it the public DEMO_KEY is used, which is heavily rate-limited.
USDA_API_KEY=
